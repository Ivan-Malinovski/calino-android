<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. This file does not exist in the release source set, so
    nothing here can reach a shipped build.

    It permits cleartext to the emulator's view of the host machine
    (10.0.2.2) and to localhost, so a throwaway CalDAV server can be run on
    the developer's machine for live tests without a certificate authority the
    device would have to be persuaded to trust. See scripts/live-caldav/.

    Everything else keeps the platform default, which is cleartext-denied: a
    real account still cannot be configured over plain HTTP, in debug or
    otherwise.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
