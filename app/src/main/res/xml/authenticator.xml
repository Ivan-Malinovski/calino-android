<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares Calino as an account type. The provider only lets an app create
    calendars under an account type it owns, so this file is what makes the
    calendar projection possible at all.

    The type is a build-type resource, not a literal: debug and release install
    side by side, and two authenticators claiming one type would break the
    ownership boundary the projection relies on. Read it through
    CalinoAccounts.accountType(context).
-->
<account-authenticator xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="@string/calino_account_type"
    android:icon="@mipmap/ic_launcher"
    android:smallIcon="@mipmap/ic_launcher"
    android:label="@string/app_name" />
