<?xml version="1.0" encoding="utf-8"?>
<!--
    The task list's entry in the picker. Static by necessity for the same
    reason as calino_widget_preview.xml: the picker renders this without
    running the app, so it shows the shape rather than real records.

    Kept honest against the ledger layout the widget uses, including the
    "Overdue" block above today and the date, rather than a time, on a row
    whose deadline has passed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launch_canvas"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Mon, May 4"
            android:textColor="@color/widget_ink3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Overdue"
        android:textColor="@color/widget_ink3"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Apr 29"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_hue_rose" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Renew passport"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/widget_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Due"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_hue_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send the invoice"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
