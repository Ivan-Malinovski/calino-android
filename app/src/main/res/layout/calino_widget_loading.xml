<?xml version="1.0" encoding="utf-8"?>
<!--
    Shown for the moment between the launcher binding the widget and Glance
    producing its first composition. Paper canvas rather than a blank rectangle,
    so the placement does not flash a hole in the home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/launch_canvas">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calino"
        android:textColor="@color/widget_ink3"
        android:textSize="13sp" />
</LinearLayout>
