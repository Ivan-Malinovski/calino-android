<?xml version="1.0" encoding="utf-8"?>
<!--
    The cards widget's entry in the picker. Static by necessity for the same
    reason as calino_widget_preview.xml: the picker renders this without running
    the app, so it shows the shape rather than real records.

    The card fills are precomputed here exactly as CalinoWidgetColors.recordTint
    computes them in Kotlin (a calendar colour at 13% over the paper canvas),
    because a layout resource cannot blend either. Each one names its source
    hue beside it in values/colors.xml.

    Only the view classes RemoteViews allows may appear here, which is why the
    rails are ImageViews rather than plain Views.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launch_canvas"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_today"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sys_preview_day"
            android:textColor="@color/widget_ink3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/widget_card_blue"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:background="@color/widget_hue_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_preview_review"
                android:textColor="@color/widget_ink"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_preview_studio"
                android:textColor="@color/widget_ink2"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_preview_morning"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/widget_card_rose"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:background="@color/widget_hue_rose" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/sys_preview_invoice"
            android:textColor="@color/widget_ink"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_due"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="7dp"
            android:src="@drawable/ic_widget_task_open"
            android:tint="@color/widget_hue_rose" />
    </LinearLayout>
</LinearLayout>
