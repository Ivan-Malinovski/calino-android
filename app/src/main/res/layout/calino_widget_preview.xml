<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget picker's preview. Static by necessity: the picker renders this
    without running the app — so it shows the shape of the agenda rather than
    real records. Kept visually honest against CalinoAgendaWidget: same paper
    canvas, same colour bar, time column and title per row.

    Only the view classes RemoteViews allows may appear here: the colour bars
    are ImageViews because a plain View is not on that list, and the launcher
    silently renders "Can't load widget" when one is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launch_canvas"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Mon, May 4"
            android:textColor="@color/widget_ink3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="9:30 AM"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_hue_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Design review"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/widget_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="2:00 PM"
            android:textColor="@color/widget_ink2"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_dot"
            android:backgroundTint="@color/widget_hue_rose" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Send the invoice"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
