<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network access. Calino talks to servers the user explicitly configures,
        the optional AI provider they choose, and Calino's fixed GitHub release
        endpoint for its in-app update check. There is no analytics or telemetry.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Local reminder delivery. Reminders are computed on the device from the
        user's own calendar data and posted by the app itself; nothing about a
        reminder leaves the device beyond the VALARM that already syncs.

        SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM on purpose: the latter
        is auto-granted and cannot be revoked, and a reminder is not worth
        taking that choice away from the user. Delivery falls back to inexact
        when it is not granted, and the Notifications screen says so.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
        Calendar Provider projection (docs/calendar-provider.md). Requested at
        the moment a calendar is opted in, never at launch: with nothing opted
        in, Calino never touches the provider. Ownership of every row we read,
        write or delete is scoped by our own account type and name, so this
        cannot reach the person's Google or Exchange calendars.

        The sync-settings permissions are what let the sync adapter be
        registered against the account at all.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Package visibility for the "is a calendar app installed" probe. The
        provider stores reminders but does not post notifications for them.
        A calendar app does, off the provider's broadcast, so Calino must
        keep its own scheduling when there is none. Without this element the
        probe returns a false negative on API 30 and above, and reminders
        would stay local forever.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:name=".CalinoApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CalinoPoc"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">
        <!--
            Assistant access (AppFunctions). Shipped disabled: Settings turns
            the component on, and Android indexes no functions for a disabled
            service. See docs/assistant-functions.md.
        -->
        <service
            android:name=".platform.assistant.CalinoAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:enabled="false"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="calino_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <!--
            The phone's own search (Samsung Finder "Apps to search in", and
            other holders of GLOBAL_SEARCH). The searchable alias is always
            declared: SearchManager only rebuilds its list on whole-package
            changes, so toggling it would leave Finder stale. The provider,
            which is what hands out data, ships disabled and is the switch.
        -->
        <activity-alias
            android:name=".PhoneSearchAlias"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity-alias>
        <provider
            android:name=".platform.search.PhoneSearchProvider"
            android:authorities="${applicationId}.search"
            android:enabled="false"
            android:exported="true"
            android:readPermission="android.permission.GLOBAL_SEARCH" />
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_function_metadata" />
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/calino/v1/commands/" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="time/epoch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="calino.malinov.ski" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
            The account authenticator. Exported because the framework binds it
            from the system process; it issues no tokens and holds no
            credential, so there is nothing here to take.
        -->
        <service
            android:name=".platform.CalinoAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.ACCOUNT_MANAGER">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!--
            The calendar sync adapter. Exported because the sync manager binds
            it from the system process; it accepts no intent of its own and
            only ever reads rows under Calino's own account type.
        -->
        <service
            android:name=".platform.CalinoSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_ADAPTER_SERVICE">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <!-- The armed reminder alarm fires here. Explicitly targeted; never broadcast to. -->
        <receiver
            android:name=".notify.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Snooze / Mark done / Tomorrow from the notification shade. -->
        <receiver
            android:name=".notify.ReminderActionReceiver"
            android:exported="false" />

        <!--
            Exported because system broadcasts require it. The receiver accepts
            only the actions below and ignores anything else it is sent.
        -->
        <receiver
            android:name=".notify.ReminderSystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The home screen agenda. Exported because APPWIDGET_UPDATE is a
            system broadcast; the three date/time actions beside it are what
            move the widget to a new "today" without a periodic poll, and are on
            the exemption list that lets an implicit broadcast still be declared
            in a manifest. Everything else is ignored.
        -->
        <receiver
            android:name=".widget.CalinoWidgetReceiver"
            android:label="Calino agenda"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calino_agenda_widget_info" />
        </receiver>

        <!--
            The second layout, offered as its own entry in the launcher's
            picker so both can sit on one home screen. No intent-filter beyond
            APPWIDGET_UPDATE: a date or time broadcast reaches the receiver
            above, and CalinoWidgets.update redraws both providers, so
            declaring those actions twice would only duplicate the work.
        -->
        <receiver
            android:name=".widget.CalinoCardsWidgetReceiver"
            android:label="Calino agenda cards"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calino_cards_widget_info" />
        </receiver>

        <!-- The task list. Same reasoning as the cards receiver above. -->
        <receiver
            android:name=".widget.CalinoTasksWidgetReceiver"
            android:label="Calino tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calino_tasks_widget_info" />
        </receiver>
    </application>
</manifest>
